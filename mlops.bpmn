                def body = [
                  "datasetVersion": versionRef,
                  "rules": [
                    ["column": tCol,              "rule": "not_null"],
                    ["column": "Clump_Thickness",  "rule": "not_null"],
                    ["column": "Clump_Thickness",  "rule": "min_value", "value": 1],
                    ["column": "Clump_Thickness",  "rule": "max_value", "value": 10],
                    ["column": "Bare_Nuclei",      "rule": "not_null"],
                    ["rule":   "row_count_min",    "value": 100]
