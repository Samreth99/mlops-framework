    <bpmn:serviceTask id="Activity_0dfesyx" name="Setup Project">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">http://host.docker.internal:8000/plan/projects</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="groovy">import groovy.json.JsonOutput
                def body = [
                  "name": "Cancer Detection MLOps",
                  "owner": "mlops-team",
                  "domain":      "healthcare",
                  "objective": "Build a production-ready breast cancer classification pipeline",
  "stakeholders": ["alice@hospital.org", "bob@datalab.io"]
                ]
                return JsonOutput.toJson(body)</camunda:script>
            </camunda:inputParameter>
            <camunda:outputParameter name="projectId">
              <camunda:script scriptFormat="groovy">import groovy.json.JsonSlurper
                def resp = new JsonSlurper().parseText(response)
                return resp.projectId.toString()</camunda:script>
            </camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0r4z2pp</bpmn:incoming>
      <bpmn:outgoing>Flow_0yrghfm</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_1wm8xl5" name="Initialize MPO Context">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="groovy">execution.getProcessEngineServices()
              .getRuntimeService()
              .createMessageCorrelation("INIT_ORCHESTRATOR")
              .processInstanceBusinessKey(projectId)
.setVariable("dataTicketType",        "FEATURE_SET")
              .setVariable("systemId",    "System-Alpha-X")
              .setVariable("env",    "development")
.setVariable("businessKey",    projectId)
           
.correlate();</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0yrghfm</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1nej3ln" messageRef="Message_0v815j9" />
    </bpmn:endEvent>
