    <bpmn:serviceTask id="Activity_0u2u0n5" name="Validate Classifier on Testing Set">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">http://host.docker.internal:8000/model/runs/execute-evaluation</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="groovy">import groovy.json.JsonOutput

def currentModelRef   = execution.getVariable("currentModelRef")
def featureSetVersion = execution.getVariable("featureVersionId")
def ticketId          = execution.getVariable("modelTicketId")

def body = [
    modelCandidateRef : currentModelRef,
    evalDatasetVersion: featureSetVersion,
    metrics           : ["accuracy", "f1_macro", "precision_macro", "recall_macro"],
    target_column     : "Class",
    ticketId          : ticketId
]
JsonOutput.toJson(body)</camunda:script>
            </camunda:inputParameter>
