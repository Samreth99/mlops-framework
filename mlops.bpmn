    <bpmn:serviceTask id="Activity_02724zs" name="Log Ticket Data">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="url">http://host.docker.internal:8000/orchestrator/tickets</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="groovy">import groovy.json.JsonOutput
def body = [
    type            : execution.getVariable("dataTicketType"),
    category        : execution.getVariable("dataTicketCategory"),
    severity        : execution.getVariable("dataTicketSeverity"),
    priority        : execution.getVariable("dataTicketPriority"),
    title           : execution.getVariable("dataTicketTitle"),
    description     : execution.getVariable("dataTicketDescription"),
    requester       : execution.getVariable("dataTicketRequester"),
    trainLocalRef   : execution.getVariable("trainLocalRef"),
    testLocalRef    : execution.getVariable("testLocalRef"),
    featureVersionId: execution.getVariable("featureVersionId")
]

JsonOutput.toJson(body)</camunda:script>
            </camunda:inputParameter>
            <camunda:outputParameter name="dataTicketId">
              <camunda:script scriptFormat="groovy">new groovy.json.JsonSlurper().parseText(response).ticketId</camunda:script>
            </camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1lt0w2a</bpmn:incoming>
      <bpmn:outgoing>Flow_1b3kk9c</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_0v94e73" name="Model_Init_Ready">
      <bpmn:incoming>Flow_0ps3tnf</bpmn:incoming>
      <bpmn:outgoing>Flow_15zhjin</bpmn:outgoing>
