    <bpmn:serviceTask id="Activity_1mc7nrd" name="Select Random Forest Classifier">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="url">http://host.docker.internal:8000/model/models</camunda:inputParameter>
