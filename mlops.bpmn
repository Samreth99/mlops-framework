            </camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="groovy">import groovy.json.JsonOutput
def fvId = featureVersionId ?: ""
def vId = fvId.contains("/") ? fvId.tokenize("/").last() : fvId
def body = [
  "featureSetId": featureSetId ?: "",
  "versionId":    vId,
  "localRef":     featureLocalRef ?: engineeredLocalRef ?: "",
  "entityKeys":   ["sample_id"]
]
return JsonOutput.toJson(body)</camunda:script>
            </camunda:inputParameter>
            <camunda:outputParameter name="materializedCount">
              <camunda:script scriptFormat="groovy">
                import groovy.json.JsonSlurper
                def resp = new JsonSlurper().parseText(response)
                return resp.materialized?.toString() ?: "0"
              </camunda:script>
            </camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
