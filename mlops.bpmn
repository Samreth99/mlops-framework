              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="groovy">import groovy.json.JsonOutput
import groovy.json.JsonSlurper

def body = [:]
body["name"] = modelName
if (execution.hasVariable("owner") &amp;&amp; owner)
    body["owner"] = owner
if (execution.hasVariable("intendedUse") &amp;&amp; intendedUse)
    body["intendedUse"] = intendedUse
if (execution.hasVariable("riskNotes") &amp;&amp; riskNotes)
    body["riskNotes"] = riskNotes
if (execution.hasVariable("tags") &amp;&amp; tags)
    body["tags"] = new JsonSlurper().parseText(tags)

JsonOutput.toJson(body)</camunda:script>
            </camunda:inputParameter>
            <camunda:outputParameter name="selectModelResponse">${response}</camunda:outputParameter>
            <camunda:outputParameter name="modelId">
              <camunda:script scriptFormat="groovy">new groovy.json.JsonSlurper().parseText(response).modelId</camunda:script>
            </camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_19gp3oh</bpmn:incoming>
      <bpmn:outgoing>Flow_18zg6xx</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_12bgcz4" name="Model_Init_Ready">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="groovy">execution.getProcessEngineServices()
    .getRuntimeService()
    .createMessageCorrelation("Model_Init_Ready")
    .processInstanceBusinessKey(execution.getBusinessKey())
    .setVariable("modelId",           modelId)
    .setVariable("experimentId",      experimentId)
    .setVariable("modelTicketType",        "INIT")
    .setVariable("modelTicketCategory",    "model-setup")
    .setVariable("modelTicketSeverity",    "low")
    .setVariable("modelTicketPriority",    "normal")
    .setVariable("modelTicketTitle",       "Model initialization complete - " + modelName)
    .setVariable("modelTicketDescription", "MLflow experiment and model family registered. Ready for training.")
    .setVariable("modelTicketRequester",   owner ?: "system")
    .correlate();</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_18zg6xx</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="Activity_0ql7wtq" name="Configure Random Forest" scriptFormat="groovy">
      <bpmn:incoming>Flow_0g1na2s</bpmn:incoming>
      <bpmn:outgoing>Flow_01jal9u</bpmn:outgoing>
      <bpmn:script>execution.setVariable("rf_n_estimators", 10)
execution.setVariable("rf_criterion",    "gini")
execution.setVariable("target_column",   "Class")
execution.setVariable("tuneRetries",     0)</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Activity_0u1yy03" name="Train RandomForest (10-fold CV)">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="url">http://host.docker.internal:8000/model/runs/execute-training</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="groovy">import groovy.json.JsonOutput

def rf_n_estimators = execution.getVariable("rf_n_estimators")
def rf_criterion    = execution.getVariable("rf_criterion")
def target_column   = execution.getVariable("target_column")
def experimentId    = execution.getVariable("experimentId")  
def featureSetVersion = execution.getVariable("featureVersionId")   
def ticketId = execution.getVariable("modelTicketId")  

def body = [
    experimentId  : experimentId,
    featureSetVersion: featureSetVersion,
    trainingConfig: [
        n_estimators: rf_n_estimators,
        criterion   : rf_criterion
    ],
    target_column : target_column,
    cv_folds      : 10,
    seed          : 42,
    ticketId : ticketId
    
]

JsonOutput.toJson(body)</camunda:script>
            </camunda:inputParameter>
            <camunda:outputParameter name="runId">
              <camunda:script scriptFormat="groovy">new groovy.json.JsonSlurper().parseText(response).runId</camunda:script>
            </camunda:outputParameter>
            <camunda:outputParameter name="modelArtifactRef">
              <camunda:script scriptFormat="groovy">new groovy.json.JsonSlurper().parseText(response).modelArtifactRef</camunda:script>
            </camunda:outputParameter>
            <camunda:outputParameter name="currentModelRef">
              <camunda:script scriptFormat="groovy">new groovy.json.JsonSlurper().parseText(response).modelArtifactRef</camunda:script>
            </camunda:outputParameter>
            <camunda:outputParameter name="trainAccuracy">
              <camunda:script scriptFormat="groovy">new groovy.json.JsonSlurper().parseText(response).metrics.accuracy as Double</camunda:script>
            </camunda:outputParameter>
            <camunda:outputParameter name="trainF1">
              <camunda:script scriptFormat="groovy">new groovy.json.JsonSlurper().parseText(response).metrics.f1_macro as Double</camunda:script>
            </camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01jal9u</bpmn:incoming>
      <bpmn:incoming>Flow_08btcr3</bpmn:incoming>
      <bpmn:outgoing>Flow_1ifrvj1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="Event_1x4x94i" name="START_TRAINING" camunda:asyncBefore="true">
      <bpmn:outgoing>Flow_0g1na2s</bpmn:outgoing>
