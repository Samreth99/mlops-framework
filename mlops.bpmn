    <bpmn:intermediateThrowEvent id="Event_1ieso8q" name="Trigger Model Init">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="groovy">execution.getProcessEngineServices()
  .getRuntimeService()
  .createMessageCorrelation("Message_StartModelMsgv3")
  .processInstanceBusinessKey(execution.getBusinessKey())
  .setVariable("experimentName",      "breast-cancer-rf-v1")
  .setVariable("experimentObjective", "Classify malignant vs benign tumors")
  .setVariable("projectId",           "proj-breast-001")
  .setVariable("modelName",           "breast-cancer-rf")
  .setVariable("owner",               "team-ds")
  .setVariable("intendedUse",         "Binary classification of breast cancer tumors")
  .setVariable("riskNotes",           "Medical context - validate before production use")
  .setVariable("tags",                "{\"domain\":\"healthcare\",\"version\":\"v1\"}")
  .correlate();</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0mui604</bpmn:incoming>
      <bpmn:outgoing>Flow_0ps3tnf</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Event_0l3jq8x" name="Event_ThrowDataReady">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="groovy">execution.getProcessEngineServices()
  .getRuntimeService()
  .createMessageCorrelation("START DATA_READYv6")
  .processInstanceBusinessKey(execution.getBusinessKey())
  .setVariable("datasetName", "breast-cancer-dataset")
  .setVariable("owner", "data-engineer")
  .setVariable("targetColumn", "Class")
  .setVariable("sourceName", "Breast Dataset")
  .setVariable("sourceType", "s3")
  .setVariable("sourceConnectionRef", "mlops/breast-dataset")
  .correlate();</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
