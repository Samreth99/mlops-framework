    <bpmn:sequenceFlow id="Flow_Trigger_DataValid" sourceRef="Activity_TriggerDataValidation" targetRef="Gateway_DataValidData" />
    <bpmn:sequenceFlow id="Flow_DataValid_Yes" sourceRef="Gateway_DataValidData" targetRef="Event_ThrowStartRetrainingEnd">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${dataValidationPassed == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DataValid_No" sourceRef="Gateway_DataValidData" targetRef="Event_DataNotValidEnd">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${dataValidationPassed != true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0fy3oci" sourceRef="Gateway_0dsg9qv" targetRef="Event_0vcrczn">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${modelRoutingLabel == 'DATA_QUALITY_ISSUE'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1kyeuer" sourceRef="Activity_0jxwubn" targetRef="Gateway_0dsg9qv" />
