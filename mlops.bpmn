              <camunda:script scriptFormat="groovy">
                import groovy.json.JsonOutput
                def body = [
                  "datasetVersion": labeledVersionRef ?: "",
                  "inlineSpec": [
                    "features": [
                      ["name": "cell_uniformity_score", "expression": "(Cell_Size_Uniformity + Cell_Shape_Uniformity) / 2"],
                      ["name": "nuclear_score",         "expression": "Bare_Nuclei + Bland_Chromatin + Normal_Nucleoli"],
                      ["name": "malignancy_index",      "expression": "Clump_Thickness * Bare_Nuclei"],
                      ["name": "morphology_score",      "expression": "Clump_Thickness + Marginal_Adhesion + Single_Epi_Cell_Size"]
                    ],
                    "includeColumns": ["sample_id", targetColumn ?: "Class"]
                  ],
                  "entityKeys": ["sample_id"]
                ]
                return JsonOutput.toJson(body)
