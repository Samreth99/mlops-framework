      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="url">http://host.docker.internal:8000/orchestrator/router/classify</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="groovy">import groovy.json.JsonOutput
def body = [
    ticketId: execution.getVariable("dataTicketId")
]
JsonOutput.toJson(body)</camunda:script>
            </camunda:inputParameter>
            <camunda:outputParameter name="dataRoutingLabel">
              <camunda:script scriptFormat="groovy">new groovy.json.JsonSlurper().parseText(response).routingLabel</camunda:script>
            </camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1oywyd5</bpmn:incoming>
      <bpmn:outgoing>Flow_0v5fdue</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_0kabone" name="Set Orchestration Context">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="url">http://host.docker.internal:8000/orchestrator/orchestrator/context</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="groovy">import groovy.json.JsonOutput
def body = [
    env            : execution.getVariable("env") ?: "staging",
    businessKey    : execution.getBusinessKey(),
    systemId       : execution.getVariable("systemId"),
    defaultPolicies: [:]
]
JsonOutput.toJson(body)</camunda:script>
            </camunda:inputParameter>
            <camunda:outputParameter name="contextId">
              <camunda:script scriptFormat="groovy">new groovy.json.JsonSlurper().parseText(response).contextId</camunda:script>
            </camunda:outputParameter>
            <camunda:outputParameter name="storedContextRef">
              <camunda:script scriptFormat="javascript">JSON.parse(response).storedContextRef;</camunda:script>
            </camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_11b9sxh</bpmn:incoming>
      <bpmn:outgoing>Flow_0xl7hl2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_DataValidData" name="Data Valid?">
      <bpmn:incoming>Flow_Trigger_DataValid</bpmn:incoming>
      <bpmn:outgoing>Flow_DataValid_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_DataValid_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_DataNotValidEnd" name="Data Not Valid">
      <bpmn:incoming>Flow_DataValid_No</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Activity_TriggerDataValidation" name="Trigger Data Validation">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="url">http://host.docker.internal:8000/data/validate</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="groovy">import groovy.json.JsonOutput
def versionRef = execution.getVariable("featureLocalRef") ?: execution.getVariable("trainLocalRef") ?: ""
def tCol = execution.getVariable("targetColumn") ?: "Class"
def body = [
  "datasetVersion": versionRef,
  "rules": [
    ["column": tCol,                      "rule": "not_null"],
    ["column": "cell_uniformity_score",   "rule": "not_null"],
    ["column": "nuclear_score",           "rule": "not_null"],
    ["column": "malignancy_index",        "rule": "not_null"],
    ["column": "morphology_score",        "rule": "not_null"],
    ["column": "malignancy_index",        "rule": "min_value", "value": 1],
    ["rule":   "row_count_min",           "value": 100]
  ],
  "severityPolicy": "warn"
]
return JsonOutput.toJson(body)</camunda:script>
            </camunda:inputParameter>
            <camunda:outputParameter name="dataValidationPassed">
              <camunda:script scriptFormat="groovy">new groovy.json.JsonSlurper().parseText(response).passed as Boolean</camunda:script>
            </camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1hxkls2</bpmn:incoming>
      <bpmn:outgoing>Flow_Trigger_DataValid</bpmn:outgoing>
    </bpmn:serviceTask>
