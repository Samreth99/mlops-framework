    <bpmn:serviceTask id="Activity_0fxdjlu" name="Configure MLflow">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
