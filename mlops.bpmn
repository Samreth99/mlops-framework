    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Activity_1jw6a7q" name="Normalize Ticket Payload">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="url">http://host.docker.internal:8000/orchestrator/tickets/${dataTicketId}</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="groovy">import groovy.json.JsonOutput
def body = [
    title      : execution.getVariable("dataTicketTitle"),
    priority   : execution.getVariable("dataTicketPriority"),
    severity   : execution.getVariable("dataTicketSeverity"),
    description: execution.getVariable("dataTicketDescription"),
    assignee   : execution.getVariable("dataTicketRequester"),
]
JsonOutput.toJson(body)</camunda:script>
            </camunda:inputParameter>
            <camunda:outputParameter name="dataTicketId">
              <camunda:script scriptFormat="groovy">new groovy.json.JsonSlurper().parseText(response).snapshot.ticketId</camunda:script>
            </camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1b3kk9c</bpmn:incoming>
      <bpmn:outgoing>Flow_1oywyd5</bpmn:outgoing>
    </bpmn:serviceTask>
