      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="groovy">execution.getProcessEngineServices()
  .getRuntimeService()
  .createMessageCorrelation("DATA_BUG_FOUND")
  .processInstanceBusinessKey(execution.getBusinessKey())
  .setVariable("experimentId", experimentId)
  .setVariable("modelId", modelId)
