      <bpmn:incoming>Flow_1ifrvj1</bpmn:incoming>
      <bpmn:outgoing>Flow_0jrsuip</bpmn:outgoing>
      <bpmn:outgoing>Flow_02p2idc</bpmn:outgoing>
      <bpmn:outgoing>Flow_148kp78</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_0hhqy5o" name="Tune RandomForest Classifier">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">http://host.docker.internal:8000/model/runs/execute-tuning</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="groovy">import groovy.json.JsonOutput

def experimentId      = execution.getVariable("experimentId")
def featureSetVersion = execution.getVariable("featureVersionId") 
def target_column     = execution.getVariable("target_column")
def ticketId          = execution.getVariable("modelTicketId")
def body = [
    experimentId     : experimentId,
    featureSetVersion: featureSetVersion,
    searchSpace      : [n_estimators: [10, 50, 100, 200], criterion: ["gini", "entropy"]],
    budget           : 8,
    target_column    : target_column,
    seed             : 42,
    ticketId         : ticketId
]
JsonOutput.toJson(body)</camunda:script>
            </camunda:inputParameter>
            <camunda:outputParameter name="rf_n_estimators">
              <camunda:script scriptFormat="groovy">new groovy.json.JsonSlurper().parseText(response).bestParams.n_estimators as Integer</camunda:script>
            </camunda:outputParameter>
            <camunda:outputParameter name="rf_criterion">
              <camunda:script scriptFormat="groovy">new groovy.json.JsonSlurper().parseText(response).bestParams.criterion as String</camunda:script>
            </camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1j62cgr</bpmn:incoming>
      <bpmn:outgoing>Flow_08btcr3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="Activity_14tkhbt" name="Increment Retry Counter" scriptFormat="groovy">
      <bpmn:incoming>Flow_02p2idc</bpmn:incoming>
      <bpmn:incoming>Flow_1rfesxw</bpmn:incoming>
      <bpmn:outgoing>Flow_1j62cgr</bpmn:outgoing>
      <bpmn:script>def retries = (execution.getVariable("tuneRetries")) as Integer
execution.setVariable("tuneRetries", retries + 1)</bpmn:script>
    </bpmn:scriptTask>
